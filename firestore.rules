rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The app signs every user in anonymously on launch (see AuthService),
    // so this only blocks access from outside the app itself. Ride/chat/
    // notification writes still target other users' uids by design (e.g.
    // notifying a driver, opening a conversation), so this stays a single
    // auth gate rather than per-document ownership checks.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
